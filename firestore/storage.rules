rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(studentId) {
      return isSignedIn() && request.auth.uid == studentId;
    }

    function isValidImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // profilePictures/{studentId}/avatar.jpg
    match /profilePictures/{studentId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(studentId) && isValidImage();
    }

    // Everything else: locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
