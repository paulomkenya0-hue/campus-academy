rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return isSignedIn() && (role() == 'super_admin' || role() == 'developer'); }
    function isStudent() { return isSignedIn() && role() == 'student'; }
    function isOwner(uid) { return isStudent() && request.auth.uid == uid; }

    // Kikomo cha XP kwa kila "ongezeko" moja la maandishi — client haiwezi kuweka XP kubwa kiholela
    function xpDelta() { return request.resource.data.xp - (resource.data.xp is number ? resource.data.xp : 0); }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // script ya local pekee
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /approvedStudents/{regNumber} {
      allow read, write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isOwner(studentId);
      allow create: if false; // script ya local pekee (setSuperAdmin/importStudents)
      allow update: if isAdmin() ||
        (isOwner(studentId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName','bio','photoBase64','xp','level','streak',
                      'unlockedStages','mustChangePassword','updatedAt']) &&
          xpDelta() >= 0 && xpDelta() <= 300); // ukomo wa XP kwa jaribio moja
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /stages/{stageId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
        match /topics/{topicId} {
          allow read: if isSignedIn();
          allow write: if isAdmin();
          match /questions/{qId} {
            // Bila server, alama sahihi lazima zionekane kwa mwanafunzi (practice mode)
            allow read: if isSignedIn();
            allow write: if isAdmin();
          }
        }
      }
    }

    match /progress/{progressId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin() || (isStudent() &&
        request.resource.data.studentId == request.auth.uid);
    }

    match /quizAttempts/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.percent is number &&
        request.resource.data.percent >= 0 && request.resource.data.percent <= 100);
    }

    match /xpTransactions/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isStudent() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.amount <= 300);
    }

    match /badges/{key} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /studentBadges/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin() || (isStudent() && request.resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /labs/{labId} {
      allow read: if isSignedIn(); // flagHash+salt zipo hapa; hazivujishi flag halisi
      allow write: if isAdmin();
    }
    match /labAttempts/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin() || (isStudent() && request.resource.data.studentId == request.auth.uid);
    }

    match /competitions/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /competitionParticipants/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /competitionResults/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    match /chatRooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /messages/{msgId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() < 2000;
        allow delete: if isAdmin() || (isStudent() && resource.data.senderId == request.auth.uid);
      }
    }

    match /notifications/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn(); // aliyesababisha tukio anaandika notification yake
      allow update: if isStudent() && resource.data.studentId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
    }
    match /announcements/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    match /suspiciousEvents/{id} {
      allow read: if isAdmin();
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
